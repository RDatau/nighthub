{
  "name": "nighthub-player",
  "productName": "NightHUB Player",
  "description": "Pemutar video lokal yang elegan dan imersif.",
  "author": "Ryan Datau",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist release",
    "lint": "tsc --noEmit",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "npm run build && node --max-old-space-size=4096 ./node_modules/electron-builder/out/cli/cli.js --win",
    "electron:build:dir": "npm run build && node --max-old-space-size=4096 ./node_modules/electron-builder/out/cli/cli.js --dir",
    "electron:build:win": "npm run build && node --max-old-space-size=4096 ./node_modules/electron-builder/out/cli/cli.js --win",
    "electron:build:linux": "npm run build && node --max-old-space-size=4096 ./node_modules/electron-builder/out/cli/cli.js --linux"
  },
  "build": {
    "appId": "com.ryandatau.nighthub",
    "fileAssociations": [
      {
        "ext": [
          "mp4",
          "mkv",
          "avi",
          "mov",
          "webm",
          "m3u8",
          "m3u",
          "ts",
          "flv",
          "wmv"
        ],
        "name": "Video File",
        "description": "Video File",
        "role": "Viewer"
      },
      {
        "ext": [
          "mp3",
          "wav",
          "flac",
          "ogg",
          "m4a",
          "aac"
        ],
        "name": "Audio File",
        "description": "Audio File",
        "role": "Viewer"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "public"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.video"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": null,
    "asar": true,
    "asarUnpack": [
      "node_modules/@ffmpeg-installer/**",
      "node_modules/@ffprobe-installer/**"
    ],
    "protocols": {
      "name": "nighthub-protocol",
      "schemes": [
        "nighthub"
      ]
    }
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@ghostery/adblocker-electron": "^2.14.1",
    "@google/genai": "^1.29.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/jsmediatags": "^3.9.6",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^5.0.4",
    "buffer": "^6.0.3",
    "cross-fetch": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "fluent-ffmpeg": "^2.1.3",
    "framer-motion": "^12.38.0",
    "hls.js": "^1.6.16",
    "jsmediatags": "^3.9.7",
    "lucide-react": "^0.546.0",
    "mediainfo.js": "^0.3.7",
    "motion": "^12.23.24",
    "mpegts.js": "^1.8.0",
    "music-metadata-browser": "^2.5.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.183.2",
    "vite": "^6.2.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wait-on": "^9.0.4"
  }
}
